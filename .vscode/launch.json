            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/*"
            ]
        },
        {
            "type": "java",
            "name": "Probar archivo con errores",
            "request": "launch",
            "mainClass": "act5_analisis_sintactico.PruebaAct5",
            "args": "prueba_errores.txt",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/*"
            ]
        },
        {
            "type": "java",
            "name": "Probar archivo mixto",
            "request": "launch",
            "mainClass": "act5_analisis_sintactico.PruebaAct5",
            "args": "prueba_mixta.txt",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
