{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Generar lexer y parser",
            "request": "launch",
            "mainClass": "act5_analisis_sintactico.GeneradorAct5",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/*"
            ]
        },
        {
            "type": "java",
            "name": "Probar archivo valido",
