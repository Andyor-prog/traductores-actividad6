{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar actividad 6",
      "type": "shell",
      "command": "javac",
      "args": [
        "-cp",
        "lib/*",
        "-d",
        "bin",
        "act5_analisis_sintactico/*.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$javac",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Generar lexer y parser de actividad 6",
      "type": "shell",
      "command": "javac",
      "args": [
        "-cp",
        "lib/*",
        "-d",
        "bin",
        "act5_analisis_sintactico/GeneradorAct5.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$javac",
      "dependsOn": [
        "Compilar actividad 6"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "javac -cp \"lib/*\" -d bin act5_analisis_sintactico/GeneradorAct5.java; if ($LASTEXITCODE -eq 0) { java -cp \"bin;lib/*\" act5_analisis_sintactico.GeneradorAct5 }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          "javac -cp 'lib/*' -d bin act5_analisis_sintactico/GeneradorAct5.java && java -cp 'bin:lib/*' act5_analisis_sintactico.GeneradorAct5"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-lc",
          "javac -cp 'lib/*' -d bin act5_analisis_sintactico/GeneradorAct5.java && java -cp 'bin:lib/*' act5_analisis_sintactico.GeneradorAct5"
        ]
      }
    }
  ]
}
